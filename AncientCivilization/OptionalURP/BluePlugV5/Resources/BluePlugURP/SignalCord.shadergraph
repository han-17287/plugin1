        "m_Id": ""
    },
    "m_Name": "CableEdge",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -335,
            "y": -135,
            "width": 180.0,
            "height": 105.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "eebb5f29a5d15d20a4800b49111a0729"
        },
        {
            "m_Id": "834b6018fa0d5761b156e66144d6f67e"
        },
        {
            "m_Id": "0a70ffdb3f325b19952eeee2e4ef4247"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "CableEdge",
    "m_FunctionSource": "",
    "m_FunctionBody": "float wobble = sin(UV.x * 81.0 + Seconds * 23.0) * sin(UV.x * 37.0 - Seconds * 13.0);\nfloat edge = abs(2.0 * UV.y - 1.0 + 0.065 * wobble);\nCoverage = 0.90 * (1.0 - smoothstep(0.54, 1.0, edge));"
}

