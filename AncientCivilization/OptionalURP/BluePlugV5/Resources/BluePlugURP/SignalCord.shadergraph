    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "TravelingPulse",
    "m_FunctionSource": "",
    "m_FunctionBody": "float position = UV.x * max(1.0, Length) * 0.60 - Seconds * 2.5 * Direction;\nPulse = 1.0 - smoothstep(0.03, 0.18, abs(frac(position) - 0.5));"
}

