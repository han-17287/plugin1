    "m_SourceType": 1,
    "m_FunctionName": "CurrentRadiance",
    "m_FunctionSource": "",
    "m_FunctionBody": "Radiance = Signal.rgb * max(0.35, Energy) * (0.52 + 0.72 * Pulse);"
}

